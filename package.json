{
  "name": "huddle",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:8082": "expo start --web --port 8082",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react-native": "^1.0.16",
    "expo": "~58.0.26",
    "expo-font": "~58.0.11",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "0.88.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.24",
    "typescript": "~6.0.3"
  }
}
