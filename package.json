{
  "name": "huddle",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "start": "npm run start --workspace @huddle/mobile",
    "dev": "node scripts/dev.mjs",
    "start:tunnel": "npm run start:tunnel --workspace @huddle/mobile",
    "mobile:start": "npm run start --workspace @huddle/mobile",
    "mobile:tunnel": "npm run start:tunnel --workspace @huddle/mobile",
    "mobile:web": "npm run web --workspace @huddle/mobile",
    "android": "npm run android --workspace @huddle/mobile",
    "ios": "npm run ios --workspace @huddle/mobile",
    "web": "npm run web --workspace @huddle/mobile",
    "web:8082": "npm run web:8082 --workspace @huddle/mobile",
    "api:dev": "npm run dev --workspace @huddle/api",
    "api:start": "npm run start --workspace @huddle/api",
    "api:seed": "npm run seed --workspace @huddle/api",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "typecheck": "npm run typecheck --workspace @huddle/mobile && npm run typecheck --workspace @huddle/api"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^26.6.6",
    "typescript": "~6.0.3"
  }
}
